EPC_API_BEARER_TOKEN=replace-with-epc-bearer-token

# Legacy Open Data Communities credentials. Keep only if you still need the retiring service
# during the transition window.
# EPC_API_EMAIL=your-email@example.com
# EPC_API_KEY=replace-with-legacy-epc-api-key

# Optional: satellite and street map views
# Sign up at https://www.mapbox.com to get an access token
MAPBOX_ACCESS_TOKEN=replace-with-mapbox-access-token

# Optional: export listings to Notion
NOTION_API_KEY=replace-with-notion-api-key
NOTION_DATABASE_ID=your-database-id
